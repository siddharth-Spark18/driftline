{
  "name": "driftline",
  "version": "0.1.0-beta.1",
  "description": "Scan your npm/JS dependency manifest for upstream changes and turn them into an agent-ready worklist.",
  "keywords": [
    "cli",
    "dependencies",
    "npm",
    "upgrades",
    "ai-agent"
  ],
  "author": "Siddharth Paneri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siddharth-Spark18/driftline.git"
  },
  "homepage": "https://github.com/siddharth-Spark18/driftline#readme",
  "bugs": {
    "url": "https://github.com/siddharth-Spark18/driftline/issues"
  },
  "type": "module",
  "bin": {
    "driftline": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5"
  }
}
